# pi6529 build pins. Every download the build makes is checked against the
# hash written here, so a build is the same on every machine. To move to a
# newer validator release, run build/bump-validator.sh (it rewrites the
# VALIDATOR_* lines from 6529's signed release feed) and commit the change.

# --- The base operating system ------------------------------------------------
# Raspberry Pi OS Lite (64-bit), Debian 13 "Trixie". glibc 2.41 (the validator
# needs 2.35 or newer). Source: Raspberry Pi Imager's OS list.
BASE_NAME="2026-10-06-raspios-trixie-arm64-lite"
BASE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz"
BASE_XZ_SHA256="483db18a48da399b5b7022ffae9a07bc6d99daab30e593aedac09b69ff422843"
BASE_IMG_SHA256="b8a393dc1c3701450b5fffbfe74368a98fb6eab7415ce456cc0cead886ea8780"

# --- The 6529 validator --------------------------------------------------------
# 6529 publishes only the newest release for download, so when a newer one is
# out this URL answers 404 and the build stops with a message to bump the pin.
VALIDATOR_VERSION="0.1.0-rc.10"
VALIDATOR_CHANNEL="test"
VALIDATOR_COMMIT="f0a3440a108e810b6e4323672da61e5116993885"
VALIDATOR_DEB_NAME="6529-validator_0.1.0_arm64.deb"
VALIDATOR_DEB_URL="https://6529.io/validator/download/0.1.0-rc.10/6529-validator_0.1.0_arm64.deb"
VALIDATOR_DEB_SHA256="8b0d82d961e04759c1a76f12dc316211e0fe69c384c5d1e5208e5ec156925df7"
# release.json of the same build: its keccak-256 is the software_id every
# validator reports. Kept for the record and for build/check-image.sh.
VALIDATOR_SOFTWARE_ID="0x61aa3b046daee5c344596065b026df2d14f5ca0b1984ff859aea92f7dd121936"

# --- The image -----------------------------------------------------------------
# Extra room added to the root partition at build time. The stock image is
# nearly full; the first boot grows the partition to the whole card anyway.
IMAGE_GROW_MB="1024"
# The validator's page listens on 127.0.0.1 at this port (see the design doc
# for why it is fixed). 6529 reserves 6529 itself, so it can't be that.
UI_PORT="7529"
